{
  "layer": "top",
  "position": "top",
  "height": 38,
  "margin-top": 6,
  "margin-left": 10,
  "margin-right": 10,
  "spacing": 4,
  "modules-left": [
    "hyprland/workspaces",
    "hyprland/window"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "idle_inhibitor",
    "network",
    "pulseaudio",
    "cpu",
    "memory",
    "custom/theme-toggle",
    "tray"
  ],
  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "format": "{windows}",
    "workspace-taskbar": {
      "enable": true,
      "format": "{icon}",
      "icon-size": 16,
      "icon-theme": "Papirus-Dark",
    },
    "unique-icons": true,
    "sort-by": "number"
  },
  "hyprland/window": {
    "format": "<b>{}</b>",
    "max-length": 30,
    "separate-outputs": true
  },
  "clock": {
    "interval": 1,
    "timezone": "Africa/Johannesburg",
    "format": "󰥔  {:%H:%M:%S}",
    "format-alt": "󰃭  {:%A, %B %d, %Y}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>"
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "󰅶",
      "deactivated": "󰛊"
    },
    "tooltip-format-activated": "Idle inhibitor active",
    "tooltip-format-deactivated": "Idle inhibitor inactive"
  },
  "cpu": {
    "interval": 2,
    "format": "󰍛 {usage:2}%",
    "on-click": "kitty -e btop"
  },
  "memory": {
    "interval": 2,
    "format": "󰟜 {percentage:2}%",
    "tooltip-format": "RAM Used: {used:0.1f}GiB / {total:0.1f}GiB",
    "on-click": "kitty -e btop"
  },
  "network": {
    "interval": 2,
    "format-wifi": "󰤨  {essid}",
    "format-ethernet": "󰈀  {ipaddr}",
    "format-disconnected": "󰤮  Offline",
    "tooltip-format": "󰅃 {bandwidthUpBits}  󰅀 {bandwidthDownBits}"
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 Muted",
    "format-icons": {
      "headphone": "󰋋",
      "default": [
        "󰕿",
        "󰖀",
        "󰕾"
      ]
    },
    "on-click": "pavucontrol"
  },
  "custom/theme-toggle": {
    "format": "{}",
    "exec": "cat /tmp/theme-mode || echo '󰔎'",
    "on-click": "~/.local/bin/toggle-theme.sh",
    "interval": 1
  },
  "tray": {
    "icon-size": 15,
    "spacing": 8
  }
}
