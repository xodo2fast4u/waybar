{
  "layer": "top",
  "position": "top",
  "height": 38,
  "margin-top": 6,
  "margin-left": 10,
  "margin-right": 10,
  "spacing": 4,
  "modules-left": ["hyprland/workspaces", "hyprland/window"],
  "modules-center": ["clock"],
  "modules-right": [
    "idle_inhibitor",
    "network",
    "pulseaudio",
    "cpu",
    "memory",
    "custom/theme-toggle",
    "tray",
  ],
  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "format": "{windows}",
    "workspace-taskbar": {
      "enable": true,
      "format": "{icon}",
      "icon-size": 16,
      "icon-theme": "Papirus-Dark",
    },
    "unique-icons": true,
    "sort-by": "number",
  },
  "hyprland/window": {
    "format": "<b>{}</b>",
    "max-length": 30,
    "separate-outputs": true,
  },
  "clock": {
    "interval": 1,
    "timezone": "Africa/Johannesburg",
    "format": "<span font_family='Noto Sans Symbols 2' fallback='false'>⏱</span> {:%H:%M:%S}",
    "format-alt": "<span font_family='Noto Sans Symbols 2' fallback='false'>🗓</span> {:%A, %B %d, %Y}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
  },
  "idle_inhibitor": {
    "format": "<span font_family='Noto Sans Symbols 2' fallback='false'>{icon}</span>",
    "format-icons": {
      "activated": "⏻",
      "deactivated": "⏾",
    },
    "tooltip-format-activated": "Idle inhibitor active",
    "tooltip-format-deactivated": "Idle inhibitor inactive",
  },
  "cpu": {
    "interval": 2,
    "format": "<span font_family='DejaVu Sans Mono' fallback='false'>⚙</span> {usage:2}%",
    "on-click": "kitty -e htop",
  },
  "memory": {
    "interval": 2,
    "format": "<span font_family='Noto Sans Symbols 2' fallback='false'>▦</span> {percentage:2}%",
    "tooltip-format": "RAM Used: {used:0.1f}GiB / {total:0.1f}GiB",
    "on-click": "kitty -e htop",
  },
  "network": {
    "interval": 2,
    "format-wifi": "<span font_family='DejaVu Sans Mono' fallback='false'>∿</span> {essid}",
    "format-ethernet": "<span font_family='Noto Sans Symbols 2' fallback='false'>🖧</span> {ipaddr}",
    "format-disconnected": "<span font_family='Noto Sans Symbols 2' fallback='false'>⚠</span>",
    "tooltip-format": "UP {bandwidthUpBits}  DOWN {bandwidthDownBits}",
  },
  "pulseaudio": {
    "format": "<span font_family='Noto Sans Symbols 2' fallback='false'>{icon}</span> {volume}%",
    "format-muted": "<span font_family='Noto Sans Symbols 2' fallback='false'>🔇</span>",
    "format-icons": {
      "headphone": "🎧",
      "default": ["🔈", "🔉", "🔊"],
    },
    "on-click": "pavucontrol",
  },
  "custom/theme-toggle": {
    "format": "<span font_family='DejaVu Sans Mono' fallback='false'>{}</span>",
    "markup": "pango",
    "exec": "cat /tmp/theme-mode.icon 2>/dev/null || echo '☾'",
    "on-click": "~/.local/bin/toggle-theme.sh",
    "interval": 1,
  },
  "tray": {
    "icon-size": 15,
    "spacing": 8,
  },
}
