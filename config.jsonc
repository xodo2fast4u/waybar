{
  "layer": "top",
  "position": "top",
  "height": 38,
  "margin-top": 6,
  "margin-left": 10,
  "margin-right": 10,
  "spacing": 4,
  "modules-left": ["hyprland/workspaces", "hyprland/window"],
  "modules-center": ["clock"],
  "modules-right": [
    "idle_inhibitor",
    "network",
    "pulseaudio",
    "cpu",
    "memory",
    "custom/theme-toggle",
    "tray",
  ],
  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "format": "{windows}",
    "workspace-taskbar": {
      "enable": true,
      "format": "{icon}",
      "icon-size": 16,
      "icon-theme": "Papirus-Dark",
    },
    "unique-icons": true,
    "sort-by": "number",
  },
  "hyprland/window": {
    "format": "<b>{}</b>",
    "max-length": 30,
    "separate-outputs": true,
  },
  "clock": {
    "interval": 1,
    "timezone": "Africa/Johannesburg",
    "format": "TIME  {:%H:%M:%S}",
    "format-alt": "DATE  {:%A, %B %d, %Y}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "ON",
      "deactivated": "IDLE",
    },
    "tooltip-format-activated": "Idle inhibitor active",
    "tooltip-format-deactivated": "Idle inhibitor inactive",
  },
  "cpu": {
    "interval": 2,
    "format": "CPU {usage:2}%",
    "on-click": "kitty -e htop",
  },
  "memory": {
    "interval": 2,
    "format": "RAM {percentage:2}%",
    "tooltip-format": "RAM Used: {used:0.1f}GiB / {total:0.1f}GiB",
    "on-click": "kitty -e htop",
  },
  "network": {
    "interval": 2,
    "format-wifi": "Wi-Fi  {essid}",
    "format-ethernet": "LAN  {ipaddr}",
    "format-disconnected": "Offline",
    "tooltip-format": "UP {bandwidthUpBits}  DOWN {bandwidthDownBits}",
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "Muted",
    "format-icons": {
      "headphone": "HP",
      "default": ["VOL", "VOL", "VOL"],
    },
    "on-click": "pavucontrol",
  },
  "custom/theme-toggle": {
    "format": "{}",
    "exec": "cat /tmp/theme-mode.icon 2>/dev/null || echo 'DARK'",
    "on-click": "~/.local/bin/toggle-theme.sh",
    "interval": 1,
  },
  "tray": {
    "icon-size": 15,
    "spacing": 8,
  },
}
